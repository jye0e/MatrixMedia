        "desc": "编辑面板里继续添加图片的“+”方块"
      },
      "editor_visibility": {
        "file": "wc_editor_visibility.png",
        "roi": null,
        "threshold": 0.85,
        "desc": "编辑面板里的“谁可以看 … 公开”整行（只用于判断编辑面板已出现）"
      },
      "editor_publish": {
        "file": "wc_editor_publish.png",
        "roi": null,
        "threshold": 0.85,
        "desc": "编辑面板里的绿色“发表”按钮"
