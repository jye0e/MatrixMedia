      },
      "file_dialog": {
        "frame": "client_tl",
        "dip": [0.0, 0.0],
        "size": [640.0, 480.0],
        "origin": "top_left",
        "desc": "“选择文件”对话框的位置（左上角，相对客户区）与固定尺寸；实测外框与客户区左上角偏差 (0,0)，尺寸 960x720 物理像素"
      }
    },
    "editor_layout": {
      "multi_row_min_images": 3,
      "max_images": 9,
      "grid_cols": 3
    },
    "multi_image": {
      "first_tile_dip": [242.67, 163.33],
      "enter_folder_settle_sec": 1.3,
      "max_selected": 9
    },
    "verify": {
      "pixel_tolerance": 25,
      "poll_interval_sec": 0.35,
      "resize_settle_sec": 1.5,
      "discover": { "min_diff": 0.15, "min_mean": 200.0, "max_dark": 0.20, "min_edge": 600.0, "min_green_row": 0.30, "timeout_sec": 5.0 },
      "moments": { "min_page_diff": 0.05, "min_std": 8.0, "min_dark": 0.01, "settle_timeout_sec": 6.0, "timeout_sec": 20.0 },
      "editor": { "min_diff": 0.10, "min_mean": 215.0, "min_std": 8.0, "min_dark": 0.002, "max_dark": 0.18, "multi_min_green": 0.50, "timeout_sec": 20.0 },
      "grid": { "min_content_std": 12.0, "max_content_mean": 228.0, "empty_min_mean": 232.0, "empty_max_std": 11.0 },
      "panel_closed": { "min_diff": 0.12, "max_feed_diff": 0.30, "timeout_sec": 20.0 },
      "discard_dialog": { "min_diff": 0.03, "min_dark": 0.02, "timeout_sec": 3.0 }
    }
  },
  "timing": {
    "countdown_sec": 5,
    "step_wait_sec": 0.8,
    "locate_timeout_sec": 8.0,
    "locate_retry_interval_sec": 0.4,
    "window_open_timeout_sec": 20.0,
    "moments_open_retries": 2,
    "dialog_timeout_sec": 15.0,
    "dialog_confirm_retries": 3,
    "editor_open_timeout_sec": 20.0,
    "total_timeout_sec": 240,
    "after_publish_wait_sec": 1.5
  },
  "content": {
    "text": "",
    "text_file": "",
    "images": []
  },
  "publish": {
    "enabled": true,
    "click_confirm_if_found": true,
    "cancel_after_no_publish": true,
    "verify_editor_closed_sec": 20.0,
    "feed_verify": {
      "enabled": true,
      "roi": [0.30, 0.05, 1.0, 1.0],
      "diff_threshold": 0.02,
      "pixel_tolerance": 25,
      "scroll_to_top": true,
      "scroll_units": 30,
      "settle_sec": 1.2,
      "timeout_sec": 15.0,
      "ocr": {
        "enabled": true,
        "lang": "chi_sim",
        "min_chars": 6
      }
    }
  },
  "safety": {
    "dry_run": false
  },
  "schedule": {
    "at": "",
    "in": "",
    "progress_interval_sec": 60,
    "min_lead_sec": 10
  },
  "screen": {
    "expected_width": 1920,
    "expected_height": 1080,
    "expected_dpi_scale": 1.5
  },
  "logging": { "dir": "logs" }
}
