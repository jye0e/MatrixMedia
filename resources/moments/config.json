      "editor_cancel": {
        "file": "wc_editor_cancel.png",
        "roi": null,
        "threshold": 0.85,
        "desc": "编辑面板里的灰色「取消」按钮（清理草稿用）"
      },
      "discard_no_keep": {
        "file": "wc_discard_nokeep.png",
        "roi": null,
        "threshold": 0.85,
        "optional": true,
        "desc": "“将此次编辑保留？”弹窗里的「不保留」按钮"
      },
      "publish_confirm": {
        "file": "wc_publish_confirm.png",
        "optional": true,
        "roi": null,
        "threshold": 0.85,
        "desc": "（可选）发表后的二次确认按钮"
      }
    }
  },
  "anchor": {
    "measured_env": {
      "resolution": "1920x1080",
      "dpi_scale": 1.5,
      "wechat_version": "4.2.0.13",
      "theme": "light",
      "frame": "client-area",
      "note": "dip 值来自 .dip-probe/result_v4/v6/v7 的模板命中中心实测；客户区与窗口外框的差：左 11 / 右 11 / 上 0 / 下 11（物理像素 @150%）"
    },
    "frames": {
      "client_tl": "客户区左上角",
      "client_center": "客户区几何中心",
      "window_right_top": "窗口外框右缘 / 上缘"
    },
    "debug_templates": false,
    "items": {
      "sidebar_moments": {
        "frame": "client_tl",
        "dip": [28.67, 254.67],
        "size": [28.0, 28.0],
        "desc": "左侧导航栏「朋友圈」图标（灰色罗盘 / 激活绿色对勾）"
      },
      "discover_moments": {
        "frame": "client_tl",
        "dip": [110.67, 100.67],
