      },
      "discover_moments": {
        "file": "wc_discover_moments.png",
        "alt_files": ["wc_discover_moments_active.png"],
        "roi": [0.0, 0.0, 0.45, 1.0],
        "threshold": 0.82,
        "desc": "“发现”浮层里的“朋友圈”一行（灰色/绿色选中两种外观）"
      },
      "moments_camera": {
        "file": "wc_moments_camera.png",
